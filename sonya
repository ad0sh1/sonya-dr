<!-- Версия для Сони - Обновлено -->
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>С днём рождения, Соня! 🎉</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(145deg, #1a1f2c 0%, #1e293b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            padding: 20px;
        }

        .card {
            max-width: 700px;
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-radius: 50px;
            padding: 40px 30px;
            box-shadow: 0 30px 50px rgba(0, 0, 0, 0.5), 0 0 0 2px rgba(129, 140, 248, 0.2) inset;
            border: 1px solid rgba(199, 210, 254, 0.3);
            text-align: center;
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #a5b4fc, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .subtitle {
            font-size: 1.3rem;
            margin-bottom: 40px;
            opacity: 0.9;
            letter-spacing: 1px;
        }

        /* Таймер */
        .timer {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .timer-item {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 30px;
            padding: 20px 15px;
            min-width: 100px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(199, 210, 254, 0.3);
        }

        .timer-number {
            font-size: 3rem;
            font-weight: bold;
            color: #c7d2fe;
            line-height: 1;
        }

        .timer-label {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            opacity: 0.7;
        }

        /* Секция "Скоро" (видна до таймера) */
        .soon-message {
            font-size: 2rem;
            margin: 50px 0;
            animation: pulse 2s infinite;
            color: #a5b4fc;
        }

        @keyframes pulse {
            0% { opacity: 0.6; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.05); }
            100% { opacity: 0.6; transform: scale(1); }
        }

        /* Контент поздравления */
        .birthday-content {
            display: block; /* Сразу показываем, раз др вот-вот */
        }

        .confession {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 40px;
            padding: 30px 25px;
            margin-bottom: 40px;
            border-left: 5px solid #818cf8;
            text-align: left;
            font-size: 1.1rem;
            line-height: 1.7;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

        .confession p {
            margin-bottom: 15px;
        }

        .confession p:last-child {
            margin-bottom: 0;
            font-style: italic;
            text-align: right;
            color: #a5b4fc;
        }

        .buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            justify-content: center;
            margin-bottom: 30px;
        }

        .btn {
            background: linear-gradient(145deg, #6366f1, #4f46e5);
            border: none;
            color: white;
            padding: 15px 30px;
            font-size: 1.1rem;
            border-radius: 60px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
            font-weight: 600;
            letter-spacing: 0.5px;
            flex: 1 1 auto;
            min-width: 200px;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(99, 102, 241, 0.6);
        }

        .surprise-message {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 40px;
            padding: 25px;
            margin-top: 25px;
            border: 2px dashed #a5b4fc;
            font-size: 1.3rem;
            line-height: 1.6;
            display: none;
            animation: fadeIn 1s;
            color: #e0e7ff;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .heart {
            color: #818cf8;
            font-size: 1.5rem;
        }

        footer {
            margin-top: 20px;
            font-size: 0.9rem;
            opacity: 0.5;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1 id="mainTitle">С днём рождения, Соня! ✨</h1>
        
        <!-- Таймер (оставлен на случай, если нужно отсчитать точное время до наступления дня) -->
        <div class="timer" id="timer">
            <div class="timer-item">
                <div class="timer-number" id="days">00</div>
                <div class="timer-label">дней</div>
            </div>
            <div class="timer-item">
                <div class="timer-number" id="hours">00</div>
                <div class="timer-label">часов</div>
            </div>
            <div class="timer-item">
                <div class="timer-number" id="minutes">00</div>
                <div class="timer-label">минут</div>
            </div>
            <div class="timer-item">
                <div class="timer-number" id="seconds">00</div>
                <div class="timer-label">секунд</div>
            </div>
        </div>

        <!-- Текст поздравления -->
        <div id="birthdayContent" class="birthday-content">
            <div class="confession">
                <p>Сонька, с днём рождения тебя! 🎉 Желаю тебе безумного кайфа от жизни, крутых моментов и чтобы всё задуманное обязательно сбывалось.</p>
                <p>Ты невероятно классный, светлый и веселый человек. Рядом с тобой всегда заряжаешься позитивом, и я очень рада, что мы дружим.</p>
                <p>Пусть этот год принесет тебе кучу ярких эмоций, классных возможностей, верных людей рядом и поменьше поводов для стресса. Сияй и будь счастлива! ✨</p>
                <p>— от подруги <3</p>
            </div>

            <!-- Интерактивные кнопки -->
            <div class="buttons">
                <button class="btn" id="btnYes">🎁 Нажми для порции добра</button>
                <button class="btn" id="btnDate">🌟 Раскрыть секрет</button>
            </div>

            <!-- Скрытые сообщения -->
            <div id="surpriseYes" class="surprise-message">
                <span class="heart">✨</span> Ты лучшая! Ура твоем дню! <span class="heart">✨</span>
            </div>

            <div id="surpriseDate" class="surprise-message">
                <span class="heart">🎉</span> А главный подарок ждет тебя при встрече! <span class="heart">🎉</span>
            </div>
        </div>

        <footer>самый лучший день у лучшей подруги</footer>
    </div>

    <script>
        // Таймер до полуночи или конкретного времени (если нужно подстроить под точный час)
        // Здесь можно указать точную дату и время праздника, например: новый Date('2026-08-04T00:00:00')
        function getTargetDate() {
            const now = new Date();
            // Пример: ставим цель на завтрашнее число 00:00
            const target = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 0);
            return target;
        }

        function updateTimer() {
            const targetDate = getTargetDate();
            const now = new Date();
            const diff = targetDate - now;

            if (diff <= 0) {
                document.getElementById('days').innerText = '00';
                document.getElementById('hours').innerText = '00';
                document.getElementById('minutes').innerText = '00';
                document.getElementById('seconds').innerText = '00';
                return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            document.getElementById('days').innerText = days.toString().padStart(2, '0');
            document.getElementById('hours').innerText = hours.toString().padStart(2, '0');
            document.getElementById('minutes').innerText = minutes.toString().padStart(2, '0');
            document.getElementById('seconds').innerText = seconds.toString().padStart(2, '0');
        }

        updateTimer();
        setInterval(updateTimer, 1000);

        // Интерактивные кнопки
        document.getElementById('btnYes')?.addEventListener('click', function() {
            const msg = document.getElementById('surpriseYes');
            msg.style.display = 'block';
            msg.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });

        document.getElementById('btnDate')?.addEventListener('click', function() {
            const msg = document.getElementById('surpriseDate');
            msg.style.display = 'block';
            msg.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
    </script>
</body>
</html>
